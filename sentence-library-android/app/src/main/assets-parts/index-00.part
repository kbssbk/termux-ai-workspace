<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="theme-color" content="#07111f" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <title>문장 라이브러리 · 독서 진행</title>
  <link rel="manifest" href="manifest.webmanifest" />
  <style>
    :root{
      --bg:#06101d;--bg2:#0a1729;--panel:rgba(12,27,47,.82);--panel2:rgba(17,37,63,.9);
      --text:#f5f8ff;--muted:#8fa5c2;--line:rgba(111,159,220,.22);--line2:rgba(78,151,255,.48);
      --blue:#4f9cff;--blue2:#3476ff;--cyan:#7bc6ff;--green:#43d39e;--amber:#ffc65a;--red:#ff6d7f;
      --radius:22px;--shadow:0 20px 60px rgba(0,0,0,.28),inset 0 1px rgba(255,255,255,.03);
    }
    *{box-sizing:border-box}html{background:var(--bg)}body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Noto Sans KR","Segoe UI",sans-serif;background:
      radial-gradient(circle at 88% 2%,rgba(52,118,255,.18),transparent 27%),
      radial-gradient(circle at -10% 36%,rgba(53,111,178,.1),transparent 26%),linear-gradient(180deg,#06101d 0%,#081320 60%,#07101c 100%);color:var(--text);min-height:100vh}
    button,input,select,textarea{font:inherit}button{cursor:pointer}a{color:inherit}.app{max-width:720px;margin:auto;min-height:100vh;padding:calc(18px + env(safe-area-inset-top)) 18px calc(118px + env(safe-area-inset-bottom))}
    .header{display:flex;align-items:center;gap:13px;margin:0 2px 26px}.logo{width:48px;height:48px;border-radius:16px;display:grid;place-items:center;font-weight:900;font-size:21px;background:linear-gradient(145deg,#3c8fff,#6550ff);box-shadow:0 8px 28px rgba(54,122,255,.25)}
    .brand{flex:1}.brand h1{font-size:20px;margin:0 0 3px;letter-spacing:-.4px}.brand p{margin:0;color:var(--muted);font-size:12px}.iconBtn{width:46px;height:46px;border-radius:16px;border:1px solid var(--line);background:rgba(13,28,47,.7);color:#a9c1e3;font-size:20px}
    .screen{display:none}.screen.active{display:block}.eyebrow{font-size:11px;letter-spacing:3.4px;color:#78aefb;text-transform:uppercase;font-weight:800;margin:0 0 10px}.title{font-size:34px;line-height:1.12;letter-spacing:-1.4px;margin:0}.sub{font-size:14px;line-height:1.65;color:var(--muted);margin:10px 0 0}
    .hero{position:relative;overflow:hidden;border:1px solid rgba(75,150,255,.32);border-radius:28px;padding:25px;background:linear-gradient(145deg,rgba(10,29,51,.98),rgba(8,21,38,.88));box-shadow:var(--shadow)}
    .hero:after{content:"";position:absolute;width:220px;height:220px;right:-82px;top:-106px;border:1px solid rgba(95,173,255,.3);border-radius:50%;box-shadow:0 0 45px rgba(63,135,255,.15),inset 0 0 45px rgba(63,135,255,.1)}
    .heroTitle{font-size:29px;line-height:1.2;margin:8px 0 8px;letter-spacing:-1px}.heroText{font-size:13px;color:#a8bad1;line-height:1.65;max-width:83%}
    .continue{margin-top:20px;padding:18px;border:1px solid rgba(78,151,255,.42);background:linear-gradient(120deg,rgba(18,42,72,.9),rgba(9,25,44,.9));border-radius:20px;position:relative;z-index:1}
    .continueTop{display:flex;align-items:center;gap:10px}.continueBadge{font-size:11px;font-weight:800;padding:6px 9px;border-radius:999px;background:rgba(79,156,255,.14);color:#88baff;border:1px solid rgba(79,156,255,.35)}.continueTitle{font-size:15px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.continueMeta{font-size:12px;color:var(--muted);margin-top:6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .progressLine{height:8px;background:rgba(255,255,255,.06);border-radius:999px;overflow:hidden;margin:13px 0 8px}.progressLine>i{display:block;height:100%;background:linear-gradient(90deg,var(--blue2),var(--cyan));border-radius:inherit;box-shadow:0 0 14px rgba(79,156,255,.45)}
    .progressRow{display:flex;justify-content:space-between;align-items:center;font-size:12px;color:var(--muted)}.percent{font-size:18px;color:#ddecff;font-weight:900}.ctaRow{display:flex;gap:9px;margin-top:14px}.btn{border:none;border-radius:15px;padding:12px 16px;font-weight:800}.btnPrimary{background:linear-gradient(135deg,#377cff,#5b52ff);color:white;box-shadow:0 8px 28px rgba(61,108,255,.2)}.btnGhost{background:rgba(255,255,255,.04);color:#bfd0e7;border:1px solid var(--line)}.btnDanger{background:rgba(255,109,127,.09);color:#ff9cac;border:1px solid rgba(255,109,127,.2)}
    .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:13px 0 28px}.stat{padding:14px;border-radius:18px;border:1px solid var(--line);background:rgba(9,23,40,.7)}.stat b{display:block;font-size:20px;margin-top:5px}.stat span{font-size:11px;color:var(--muted)}
    .sectionHead{display:flex;align-items:end;justify-content:space-between;margin:27px 2px 13px}.sectionHead h2{margin:0;font-size:20px;letter-spacing:-.6px}.sectionHead p{margin:4px 0 0;color:var(--muted);font-size:12px}.linkBtn{background:none;border:0;color:#76adff;font-weight:800;font-size:12px}
    .issueList{display:grid;gap:13px}.issueCard{border:1px solid var(--line);border-radius:22px;background:linear-gradient(145deg,rgba(13,29,50,.86),rgba(8,20,35,.86));box-shadow:var(--shadow);overflow:hidden}.issueSummary{padding:17px;display:grid;grid-template-columns:56px 1fr auto;gap:13px;align-items:center}.ring{--p:0;width:56px;height:56px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(var(--blue) calc(var(--p)*1%),rgba(255,255,255,.07) 0);position:relative}.ring:after{content:"";position:absolute;inset:5px;background:#0a1829;border-radius:50%}.ring strong{z-index:1;font-size:12px}.issueName{font-size:15px;font-weight:900;margin:0 0 4px}.issueMeta{font-size:11px;color:var(--muted);line-height:1.4}.status{display:inline-flex;align-items:center;gap:5px;border-radius:999px;padding:6px 9px;font-size:10px;font-weight:900;border:1px solid}.status.unfinished{color:#9eb0c7;background:rgba(158,176,199,.08);border-color:rgba(158,176,199,.22)}.status.progress{color:#ffd47d;background:rgba(255,198,90,.08);border-color:rgba(255,198,90,.25)}.status.done{color:#77e6bd;background:rgba(67,211,158,.08);border-color:rgba(67,211,158,.25)}
    .chev{background:none;border:0;color:#7fa8dd;font-size:18px;padding:8px}.issueBody{display:none;border-top:1px solid var(--line);padding:14px 14px 18px}.issueCard.open .issueBody{display:block}.issueTools{display:flex;gap:8px;justify-content:flex-end;margin-bottom:12px}.tiny{font-size:11px;padding:8px 10px;border-radius:12px}
    .article{padding:14px;border:1px solid rgba(109,158,219,.18);border-radius:18px;background:rgba(255,255,255,.025);margin-top:10px}.articleTop{display:flex;gap:10px;align-items:flex-start}.articleIndex{width:27px;height:27px;display:grid;place-items:center;border-radius:9px;background:rgba(79,156,255,.1);color:#86b8ff;font-size:11px;font-weight:900;flex:0 0 auto}.articleTitle{font-size:13px;font-weight:800;line-height:1.45;flex:1}.articlePct{font-size:14px;font-weight:900;color:#d9e7fa}.statusGroup{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:12px}.statusBtn{padding:9px 5px;border-radius:12px;background:rgba(255,255,255,.03);border:1px solid var(--line);color:#91a5bf;font-size:11px;font-weight:800}.statusBtn.active[data-status="미완"]{color:#fff;background:rgba(132,151,175,.14);border-color:rgba(171,189,210,.48)}.statusBtn.active[data-status="진행중"]{color:#ffe0a0;background:rgba(255,198,90,.11);border-color:rgba(255,198,90,.44)}.statusBtn.active[data-status="완성"]{color:#96f2d0;background:rgba(67,211,158,.11);border-color:rgba(67,211,158,.42)}
    .sliderBox{margin-top:12px;padding:10px 12px;border-radius:13px;background:rgba(79,156,255,.055);display:none}.article.inprogress .sliderBox{display:block}.sliderHead{display:flex;justify-content:space-between;color:#a9bad1;font-size:11px;margin-bottom:8px}.sliderHead strong{color:#84b7ff;font-size:13px}input[type=range]{width:100%;accent-color:#4f9cff}.articleActions{display:flex;justify-content:space-between;gap:8px;margin-top:10px}.articleActions button{background:none;border:0;color:#7e98b8;font-size:11px;padding:4px}.articleActions .quoteAdd{color:#77adff}
    .empty{border:1px dashed rgba(126,164,212,.25);border-radius:22px;text-align:center;padding:38px 20px;color:#94a7c0}.empty strong{display:block;color:#d6e1f0;margin-bottom:6px}.empty button{margin-top:16px}
    .searchBox{margin-top:20px;border:1px solid var(--line);border-radius:22px;padding:14px;background:rgba(11,26,45,.8)}.searchInput{display:flex;align-items:center;gap:10px;padding:12px 13px;border-radius:15px;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.035)}.searchInput input{flex:1;background:transparent;border:0;outline:0;color:white;font-size:14px}.searchInput input::placeholder{color:#6f849f}.chips{display:flex;gap:7px;overflow:auto;padding:12px 0 2px;scrollbar-width:none}.chip{white-space:nowrap;border:1px solid var(--line);border-radius:999px;background:transparent;color:#90a5be;padding:8px 11px;font-size:11px;font-weight:800}.chip.active{background:rgba(79,156,255,.13);border-color:#4f9cff;color:#c7e0ff;box-shadow:0 0 18px rgba(79,156,255,.12)}
    .result{padding:14px;border:1px solid var(--line);border-radius:18px;background:rgba(255,255,255,.025);margin-top:10px}.resultTitle{font-size:13px;font-weight:900}.resultMeta{font-size:11px;color:var(--muted);margin-top:5px}.resultQuote{font-size:13px;line-height:1.6;color:#dce7f5;margin-top:8px;padding-left:11px;border-left:2px solid #4f9cff}
    .bottomNav{position:fixed;z-index:30;bottom:calc(10px + env(safe-area-inset-bottom));left:50%;transform:translateX(-50%);width:min(calc(100% - 28px),692px);display:grid;grid-template-columns:repeat(3,1fr);gap:5px;padding:7px;border-radius:24px;border:1px solid rgba(89,143,211,.3);background:rgba(8,22,39,.94);backdrop-filter:blur(18px);box-shadow:0 16px 45px rgba(0,0,0,.35)}.navBtn{height:58px;border:0;border-radius:18px;background:transparent;color:#7f94ad;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;font-size:10px;font-weight:800}.navBtn span:first-child{font-size:21px}.navBtn.active{background:linear-gradient(145deg,rgba(55,124,255,.92),rgba(86,78,255,.92));color:white;box-shadow:0 8px 24px rgba(53,115,255,.24)}
    .modalWrap{position:fixed;inset:0;z-index:60;background:rgba(0,5,13,.74);backdrop-filter:blur(8px);display:none;align-items:flex-end;justify-content:center}.modalWrap.show{display:flex}.modal{width:min(100%,720px);max-height:88vh;overflow:auto;background:#0a1728;border:1px solid rgba(94,153,228,.27);border-radius:28px 28px 0 0;padding:20px 18px calc(24px + env(safe-area-inset-bottom));box-shadow:0 -20px 80px rgba(0,0,0,.46)}.modalHead{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}.modalHead h3{margin:0;font-size:20px}.close{border:0;background:rgba(255,255,255,.05);color:#a9bdd6;width:38px;height:38px;border-radius:13px}.field{margin-top:13px}.field label{display:block;font-size:11px;color:#9fb0c8;font-weight:800;margin:0 0 7px}.field input,.field select,.field textarea{width:100%;border:1px solid var(--line);background:rgba(255,255,255,.035);color:white;border-radius:14px;padding:12px;outline:0}.field textarea{min-height:105px;resize:vertical}.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}.modalActions{display:flex;gap:9px;margin-top:18px}.modalActions .btn{flex:1}.mutedNote{font-size:11px;color:#738aa7;line-height:1.55;margin-top:8px}.menuPanel{position:fixed;z-index:55;top:78px;right:max(18px,calc((100vw - 720px)/2 + 18px));width:210px;border:1px solid var(--line);background:rgba(8,22,39,.97);border-radius:18px;padding:8px;box-shadow:var(--shadow);display:none}.menuPanel.show{display:block}.menuPanel button,.menuPanel label{display:block;width:100%;text-align:left;border:0;background:transparent;color:#c7d6e9;padding:11px 12px;border-radius:12px;font-size:12px}.menuPanel button:hover,.menuPanel label:hover{background:rgba(255,255,255,.04)}.menuPanel input{display:none}.toast{position:fixed;z-index:90;left:50%;bottom:100px;transform:translate(-50%,20px);opacity:0;pointer-events:none;background:#dfeaff;color:#10223a;border-radius:999px;padding:11px 15px;font-weight:800;font-size:12px;transition:.2s}.toast.show{opacity:1;transform:translate(-50%,0)}
    @media (max-width:400px){.app{padding-left:14px;padding-right:14px}.title{font-size:30px}.hero{padding:21px}.issueSummary{grid-template-columns:50px 1fr auto}.ring{width:50px;height:50px}.statusGroup{gap:5px}.statusBtn{font-size:10px}.stats{gap:7px}.stat{padding:12px 10px}}
  
    .officialSync{margin:16px 0 4px;padding:15px;border-radius:18px;border:1px solid rgba(79,156,255,.28);background:linear-gradient(135deg,rgba(24,57,94,.55),rgba(9,25,44,.72))}.syncTop{display:flex;align-items:center;justify-content:space-between;gap:10px}.syncTitle{font-size:13px;font-weight:900}.syncMeta{font-size:11px;color:var(--muted);margin-top:4px;line-height:1.45}.syncBar{height:6px;background:rgba(255,255,255,.06);border-radius:99px;overflow:hidden;margin:11px 0 8px}.syncBar i{display:block;height:100%;background:linear-gradient(90deg,var(--blue2),var(--cyan));border-radius:inherit}.syncActions{display:flex;gap:7px;flex-wrap:wrap}.yearRow{display:flex;gap:10px;align-items:center;margin:14px 0}.yearSelect{flex:1;border:1px solid var(--line);background:#0b1b2f;color:#eaf2ff;border-radius:15px;padding:12px 14px;font-weight:900;outline:0}.sourceBadge{display:inline-flex;align-items:center;gap:5px;color:#82b7ff;font-size:10px;font-weight:900;border:1px solid rgba(79,156,255,.28);background:rgba(79,156,255,.08);border-radius:999px;padding:5px 8px;margin-top:6px}.sourceLink{color:#83b8ff!important;text-decoration:none;font-weight:900!important}.syncSpinner{display:inline-block;width:12px;height:12px;border:2px solid rgba(255,255,255,.18);border-top-color:#7bc6ff;border-radius:50%;animation:spin .8s linear infinite}@keyframes spin{to{transform:rotate(360deg)}
  </style>
</head>
<body>
  <div class="app">
    <header class="header">
      <div class="logo">문</div>
      <div class="brand"><h1>문장 라이브러리</h1><p>읽고 · 진행하고 · 다시 찾기</p></div>
      <button class="iconBtn" id="menuBtn" aria-label="메뉴">•••</button>
    </header>

    <main>
      <section id="homeScreen" class="screen active">
        <div class="hero">
          <div class="eyebrow">READING PROGRESS</div>
          <h2 class="heroTitle">어디까지 읽었는지<br>한눈에 확인하세요.</h2>
          <div class="heroText">호수별 · 기사별로 <b>미완 / 진행중 / 완성</b>을 기록하고, 진행률은 자동으로 계산됩니다.</div>
          <div id="continueCard" class="continue"></div>
        </div>
        <div id="homeStats" class="stats"></div>
        <div class="sectionHead"><div><h2>최근 호수</h2><p>기사 진행률을 합산해 호수 전체 퍼센트를 보여줍니다.</p></div><button class="linkBtn" data-go="progress">전체 보기</button></div>
        <div id="recentIssues" class="issueList"></div>
      </section>

      <section id="progressScreen" class="screen">
        <div class="eyebrow">ISSUE TRACKER</div>
        <h2 class="title">독서 진행</h2>
        <p class="sub">JW.ORG의 한국어 「파수대—연구용」 목차를 기준으로 2026~2001년 호수와 기사 제목을 불러오고, 각 기사마다 상태와 퍼센트를 기록합니다.</p>
        <div id="officialSyncBox" class="officialSync"></div>
        <div class="sectionHead"><div><h2>호수별 진행</h2><p id="issueCountText">0개 호수</p></div><button class="btn btnPrimary tiny" id="addIssueBtn">+ 직접 추가</button></div>
        <div class="yearRow"><select id="yearSelect" class="yearSelect"></select><span class="sourceBadge">✓ JW.ORG 기준</span></div>
        <div class="chips" id="issueFilterChips">
          <button class="chip active" data-filter="전체">전체</button><button class="chip" data-filter="미완">미완</button><button class="chip" data-filter="진행중">진행중</button><button class="chip" data-filter="완성">완성</button>
        </div>
        <div id="issueList" class="issueList"></div>
      </section>

      <section id="searchScreen" class="screen">
        <div class="eyebrow">FIND AGAIN</div>
        <h2 class="title">검색 · 파악</h2>
        <p class="sub">기사 제목과 문장 메모를 찾고, 진행 상태나 퍼센트 구간으로 걸러볼 수 있습니다.</p>
        <div class="searchBox">
          <div class="searchInput"><span>⌕</span><input id="searchInput" placeholder="기사 · 문장 · 메모 검색"><button class="chev" id="clearSearch">×</button></div>
          <div class="chips" id="searchStatusChips"><button class="chip active" data-status-filter="전체">전체</button><button class="chip" data-status-filter="미완">미완</button><button class="chip" data-status-filter="진행중">진행중</button><button class="chip" data-status-filter="완성">완성</button></div>
          <div class="chips" id="searchRangeChips"><button class="chip active" data-range="all">전체 %</button><button class="chip" data-range="0-25">0~25%</button><button class="chip" data-range="26-50">26~50%</button><button class="chip" data-range="51-75">51~75%</button><button class="chip" data-range="76-100">76~100%</button></div>
        </div>
